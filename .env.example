# URL base de la API REST del backend de PlayBoss
VITE_API_URL=http://localhost/playboss-casino-api/public/api

# Origen de los datos:
#   auto (por defecto) -> usa la API y, si no responde, cae a datos simulados (mock)
#   api                -> solo API real (los errores se muestran tal cual)
#   mock               -> siempre datos simulados (demo sin backend)
VITE_DATA_MODE=auto

# Muestra la sección de partidos/cuotas (Home y Apuestas). Por defecto activa;
# poner en false para ocultarla.
VITE_FEATURE_MATCHES=true
